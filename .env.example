# Copy to .env and fill in. `.env` is gitignored.
#
# Required for the LIVE run mode only. Both --selftest and --mock-llm run to
# completion with this file absent.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-4-5.
# GDD §4.1 routing: Opus-class where output is judgement (the Mechanic Designer
# and the Red-Teamer), Sonnet-class for anything verifiable by running it (the
# Keeper and the Playtester). This crew uses one model for all five roles; set
# it to an Opus-class model if you want the judgement halves upgraded, at
# roughly 5x the cost of a run.
CREW_MODEL=claude-sonnet-4-5
